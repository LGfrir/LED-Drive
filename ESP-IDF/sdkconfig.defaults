CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8MB Octal PSRAM on the ESP32-S3 module
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
# Keep booting if PSRAM init fails while bringing up a new board
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# LVGL: 160x128 ST7735 dashboard
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# OTA: new image must confirm itself or bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
